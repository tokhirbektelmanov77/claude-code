# ---- Database ----
DATABASE_URL=postgresql://barberflow:barberflow@localhost:5432/barberflow?schema=public
# Separate database used by `pnpm test` (integration tests truncate it).
TEST_DATABASE_URL=postgresql://barberflow:barberflow@localhost:5432/barberflow_test?schema=public

# ---- API ----
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
SESSION_TTL_DAYS=30
COOKIE_SECURE=false
TRUST_PROXY=false
# DEV/E2E ONLY: turn off request throttling (E2E signs in and books many times). Refused in production.
RELAX_RATE_LIMITS=false

# No Telegram bot, no SMS: clients book with name + phone (secret manage link),
# staff sign in with phone + password. Create a platform admin with `pnpm admin:create`.

# ---- Web ----
# Where the Next.js server proxies /api/* to.
API_INTERNAL_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Worker ----
# Subscription/session housekeeping interval.
WORKER_INTERVAL_MS=600000
