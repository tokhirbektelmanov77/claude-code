# ---- Database ----
DATABASE_URL=postgresql://barberflow:barberflow@localhost:5432/barberflow?schema=public
# Separate database used by `pnpm test` (integration tests truncate it).
TEST_DATABASE_URL=postgresql://barberflow:barberflow@localhost:5432/barberflow_test?schema=public

# ---- API ----
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
# HMAC key for one-time codes. Generate: openssl rand -hex 32
OTP_SECRET=dev-only-otp-secret-change-me
# DEVELOPMENT ONLY. Returns the OTP in the API response and shows it in the UI under a
# "test mode" banner when no SMS provider is configured. The API refuses to start with this in production.
OTP_DEV_MODE=true
# none | console (console = dev only, logs the SMS text instead of sending)
SMS_PROVIDER=none
SESSION_TTL_DAYS=30
COOKIE_SECURE=false
TRUST_PROXY=false
# DEV/E2E ONLY: turn off throttling and the per-phone OTP cap (E2E logs in many times). Refused in production.
RELAX_RATE_LIMITS=false
# Comma-separated E.164 phones that become PLATFORM_ADMIN on login (optional bootstrap).
PLATFORM_ADMIN_PHONES=

# ---- Telegram (optional) ----
# Create a bot with @BotFather. Without a token Telegram login / notifications are disabled
# and notification jobs end as SKIPPED (never reported as sent).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_AUTH_MAX_AGE=86400

# ---- Web ----
# Where the Next.js server proxies /api/* to.
API_INTERNAL_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Worker ----
WORKER_POLL_MS=5000
