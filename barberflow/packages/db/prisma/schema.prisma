// BARBERFLOW data model.
// Conventions:
//  * Every tenant-owned table carries business_id and every query from the API filters by it.
//  * All timestamps are stored in UTC (timestamptz). Display timezone is per business (Asia/Tashkent).
//  * Money is stored as whole UZS in integer columns (no tiyin in MVP).
//  * The appointment overlap guarantee is a Postgres EXCLUSION constraint added in raw SQL
//    (see migrations/*_init/migration.sql), Prisma cannot express it.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  USER
  PLATFORM_ADMIN
}

enum MemberRole {
  OWNER
  MANAGER
  BARBER
}

enum MemberStatus {
  ACTIVE
  DISABLED
}

enum BusinessStatus {
  ACTIVE
  BLOCKED
}

enum AppointmentStatus {
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentSource {
  ONLINE
  TELEGRAM
  MANUAL
}

enum ScheduleExceptionType {
  DAY_OFF
  VACATION
  BLOCK
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  EXPIRED
  CANCELLED
}

enum PlanPricing {
  FLAT
  PER_SEAT
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum PaymentMethod {
  MANUAL
  BANK_TRANSFER
  CASH
  PAYME
  CLICK
}

enum NotificationChannel {
  TELEGRAM
  SMS
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  SKIPPED
}

model User {
  id                String       @id @default(uuid()) @db.Uuid
  phone             String?      @unique
  name              String?
  locale            String       @default("ru")
  platformRole      PlatformRole @default(USER) @map("platform_role")
  telegramId        BigInt?      @unique @map("telegram_id")
  telegramUsername  String?      @map("telegram_username")
  // Chat the bot may write to. Only set after the user started the bot or allowed messages.
  telegramChatId    BigInt?      @map("telegram_chat_id")
  marketingConsent  Boolean      @default(false) @map("marketing_consent")
  privacyAcceptedAt DateTime?    @map("privacy_accepted_at") @db.Timestamptz(3)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime?    @map("deleted_at") @db.Timestamptz(3)

  sessions          Session[]
  memberships       BusinessMember[]
  barberProfiles    Barber[]
  customerProfiles  Customer[]
  auditLogs         AuditLog[]
  telegramLinks     TelegramLinkToken[]

  @@map("users")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  // sha256 of the opaque token; the raw token only lives in the client's HttpOnly cookie.
  tokenHash  String    @unique @map("token_hash")
  userAgent  String?   @map("user_agent")
  ip         String?
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model OtpCode {
  id         String    @id @default(uuid()) @db.Uuid
  phone      String
  // HMAC-SHA256(code, OTP_SECRET); codes are never stored in clear text.
  codeHash   String    @map("code_hash")
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  ip         String?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([phone, createdAt])
  @@map("otp_codes")
}

model TelegramLinkToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("telegram_link_tokens")
}

model Business {
  id                    String         @id @default(uuid()) @db.Uuid
  slug                  String         @unique
  name                  String
  city                  String?
  address               String?
  phone                 String?
  description           String?
  coverUrl              String?        @map("cover_url")
  latitude              Float?
  longitude             Float?
  timezone              String         @default("Asia/Tashkent")
  currency              String         @default("UZS")
  status                BusinessStatus @default(ACTIVE)
  blockedReason         String?        @map("blocked_reason")
  // Booking rules
  bookingHorizonDays    Int            @default(30) @map("booking_horizon_days")
  minLeadMinutes        Int            @default(60) @map("min_lead_minutes")
  slotStepMinutes       Int            @default(15) @map("slot_step_minutes")
  cancellationMinHours  Int            @default(2) @map("cancellation_min_hours")
  cancellationPolicy    String?        @map("cancellation_policy")
  // 1..7, 7 = onboarding finished
  onboardingStep        Int            @default(2) @map("onboarding_step")
  isDemo                Boolean        @default(false) @map("is_demo")
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  members           BusinessMember[]
  invitations       Invitation[]
  branches          Branch[]
  barbers           Barber[]
  services          Service[]
  customers         Customer[]
  appointments      Appointment[]
  appointmentEvents AppointmentEvent[]
  subscription      Subscription?
  payments          Payment[]
  notificationJobs  NotificationJob[]
  auditLogs         AuditLog[]

  @@map("businesses")
}

model BusinessMember {
  id         String       @id @default(uuid()) @db.Uuid
  businessId String       @map("business_id") @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  role       MemberRole
  status     MemberStatus @default(ACTIVE)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([userId])
  @@map("business_members")
}

model Invitation {
  id         String     @id @default(uuid()) @db.Uuid
  businessId String     @map("business_id") @db.Uuid
  phone      String
  role       MemberRole
  barberId   String?    @map("barber_id") @db.Uuid
  invitedBy  String?    @map("invited_by") @db.Uuid
  expiresAt  DateTime   @map("expires_at") @db.Timestamptz(3)
  acceptedAt DateTime?  @map("accepted_at") @db.Timestamptz(3)
  revokedAt  DateTime?  @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([phone])
  @@index([businessId])
  @@map("invitations")
}

model Branch {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  name       String
  city       String?
  address    String?
  phone      String?
  latitude   Float?
  longitude  Float?
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  barbers      Barber[]
  appointments Appointment[]

  @@index([businessId])
  @@map("branches")
}

model Barber {
  id             String   @id @default(uuid()) @db.Uuid
  businessId     String   @map("business_id") @db.Uuid
  branchId       String?  @map("branch_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  // Public personal link: /b/<slug>. Globally unique.
  slug           String   @unique
  name           String
  specialization String?
  bio            String?
  photoUrl       String?  @map("photo_url")
  isActive       Boolean  @default(true) @map("is_active")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  business           Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch             Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  user               User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  services           BarberService[]
  workingHours       WorkingHours[]
  scheduleExceptions ScheduleException[]
  appointments       Appointment[]

  @@index([businessId])
  @@index([userId])
  @@map("barbers")
}

model Service {
  id             String   @id @default(uuid()) @db.Uuid
  businessId     String   @map("business_id") @db.Uuid
  name           String
  nameUz         String?  @map("name_uz")
  description    String?
  priceUzs       Int      @map("price_uzs")
  durationMin    Int      @map("duration_min")
  // Technical break after the service (cleanup / prep). Blocks the barber but is not billed.
  bufferAfterMin Int      @default(0) @map("buffer_after_min")
  isActive       Boolean  @default(true) @map("is_active")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  business     Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  barbers      BarberService[]
  appointments Appointment[]

  @@index([businessId])
  @@map("services")
}

model BarberService {
  barberId         String @map("barber_id") @db.Uuid
  serviceId        String @map("service_id") @db.Uuid
  // Optional per-barber overrides (e.g. senior barber charges more).
  priceOverrideUzs Int?   @map("price_override_uzs")
  durationOverride Int?   @map("duration_override")

  barber  Barber  @relation(fields: [barberId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([barberId, serviceId])
  @@map("barber_services")
}

model Customer {
  id         String    @id @default(uuid()) @db.Uuid
  businessId String    @map("business_id") @db.Uuid
  userId     String?   @map("user_id") @db.Uuid
  name       String
  phone      String?
  notes      String?
  // When the customer agreed to processing of personal data for this business.
  consentAt  DateTime? @map("consent_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  // Anonymised (PII wiped) on deletion request; row kept so appointment history stays consistent.
  anonymizedAt DateTime? @map("anonymized_at") @db.Timestamptz(3)

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  appointments Appointment[]

  @@unique([businessId, phone])
  @@index([businessId, userId])
  @@map("customers")
}

model WorkingHours {
  id       String @id @default(uuid()) @db.Uuid
  barberId String @map("barber_id") @db.Uuid
  // ISO weekday 1 = Monday … 7 = Sunday, in the business timezone.
  weekday  Int
  // Minutes from local midnight. Several rows per weekday express breaks (e.g. 10:00–13:00, 14:00–20:00).
  startMin Int    @map("start_min")
  endMin   Int    @map("end_min")

  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId, weekday])
  @@map("working_hours")
}

model ScheduleException {
  id        String                @id @default(uuid()) @db.Uuid
  barberId  String                @map("barber_id") @db.Uuid
  type      ScheduleExceptionType
  startsAt  DateTime              @map("starts_at") @db.Timestamptz(3)
  endsAt    DateTime              @map("ends_at") @db.Timestamptz(3)
  note      String?
  createdBy String?               @map("created_by") @db.Uuid
  createdAt DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId, startsAt])
  @@map("schedule_exceptions")
}

model Appointment {
  id              String            @id @default(uuid()) @db.Uuid
  businessId      String            @map("business_id") @db.Uuid
  branchId        String?           @map("branch_id") @db.Uuid
  barberId        String            @map("barber_id") @db.Uuid
  serviceId       String            @map("service_id") @db.Uuid
  customerId      String            @map("customer_id") @db.Uuid
  startsAt        DateTime          @map("starts_at") @db.Timestamptz(3)
  // End of the billed service.
  endsAt          DateTime          @map("ends_at") @db.Timestamptz(3)
  // endsAt + technical break. This is the interval protected by the exclusion constraint.
  blockedUntil    DateTime          @map("blocked_until") @db.Timestamptz(3)
  status          AppointmentStatus @default(CONFIRMED)
  source          AppointmentSource @default(ONLINE)
  // Snapshot of the price list at booking time so later price edits don't rewrite history.
  priceUzs        Int               @map("price_uzs")
  durationMin     Int               @map("duration_min")
  bufferAfterMin  Int               @default(0) @map("buffer_after_min")
  serviceName     String            @map("service_name")
  customerNote    String?           @map("customer_note")
  cancelReason    String?           @map("cancel_reason")
  idempotencyKey  String?           @unique @map("idempotency_key")
  createdByUserId String?           @map("created_by_user_id") @db.Uuid
  cancelledAt     DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  completedAt     DateTime?         @map("completed_at") @db.Timestamptz(3)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
  barber   Barber             @relation(fields: [barberId], references: [id], onDelete: Restrict)
  service  Service            @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  customer Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  events   AppointmentEvent[]
  jobs     NotificationJob[]

  @@index([businessId, startsAt])
  @@index([barberId, startsAt])
  @@index([customerId])
  @@map("appointments")
}

model AppointmentEvent {
  id            String   @id @default(uuid()) @db.Uuid
  appointmentId String   @map("appointment_id") @db.Uuid
  businessId    String   @map("business_id") @db.Uuid
  // CREATED | RESCHEDULED | CANCELLED | COMPLETED | NO_SHOW | NOTE
  type          String
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  data          Json?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  business    Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@map("appointment_events")
}

model SubscriptionPlan {
  id            String      @id @default(uuid()) @db.Uuid
  code          String      @unique
  name          String
  description   String?
  pricing       PlanPricing
  priceUzs      Int         @map("price_uzs")
  minSeats      Int         @default(1) @map("min_seats")
  maxSeats      Int?        @map("max_seats")
  trialDays     Int         @default(14) @map("trial_days")
  isActive      Boolean     @default(true) @map("is_active")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  businessId         String             @unique @map("business_id") @db.Uuid
  planId             String             @map("plan_id") @db.Uuid
  status             SubscriptionStatus
  seats              Int                @default(1)
  trialEndsAt        DateTime?          @map("trial_ends_at") @db.Timestamptz(3)
  currentPeriodStart DateTime?          @map("current_period_start") @db.Timestamptz(3)
  currentPeriodEnd   DateTime?          @map("current_period_end") @db.Timestamptz(3)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan     SubscriptionPlan @relation(fields: [planId], references: [id])
  payments Payment[]

  @@map("subscriptions")
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  businessId        String        @map("business_id") @db.Uuid
  subscriptionId    String        @map("subscription_id") @db.Uuid
  amountUzs         Int           @map("amount_uzs")
  periodMonths      Int           @default(1) @map("period_months")
  method            PaymentMethod @default(MANUAL)
  status            PaymentStatus @default(PENDING)
  // Bank / provider transaction reference typed in by the admin or provider module.
  reference         String?
  note              String?
  provider          String?
  providerPaymentId String?       @unique @map("provider_payment_id")
  createdByUserId   String?       @map("created_by_user_id") @db.Uuid
  confirmedByUserId String?       @map("confirmed_by_user_id") @db.Uuid
  confirmedAt       DateTime?     @map("confirmed_at") @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("payments")
}

model NotificationJob {
  id            String              @id @default(uuid()) @db.Uuid
  businessId    String?             @map("business_id") @db.Uuid
  appointmentId String?             @map("appointment_id") @db.Uuid
  recipientUserId String?           @map("recipient_user_id") @db.Uuid
  channel       NotificationChannel
  // APPOINTMENT_CREATED | APPOINTMENT_CANCELLED | APPOINTMENT_RESCHEDULED | REMINDER_24H | REMINDER_2H | NEW_BOOKING_FOR_BARBER ...
  type          String
  payload       Json
  // Prevents duplicate sends for the same logical event.
  dedupeKey     String              @unique @map("dedupe_key")
  status        NotificationStatus  @default(PENDING)
  runAt         DateTime            @default(now()) @map("run_at") @db.Timestamptz(3)
  attempts      Int                 @default(0)
  maxAttempts   Int                 @default(5) @map("max_attempts")
  lastError     String?             @map("last_error")
  lockedAt      DateTime?           @map("locked_at") @db.Timestamptz(3)
  lockedBy      String?             @map("locked_by")
  sentAt        DateTime?           @map("sent_at") @db.Timestamptz(3)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  business    Business?    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([status, runAt])
  @@map("notification_jobs")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  businessId  String?  @map("business_id") @db.Uuid
  // e.g. business.block, payment.confirm, service.update, customer.delete
  action      String
  entityType  String?  @map("entity_type")
  entityId    String?  @map("entity_id")
  data        Json?
  ip          String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor    User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model ErrorLog {
  id        String   @id @default(uuid()) @db.Uuid
  source    String
  message   String
  stack     String?
  context   Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@map("error_logs")
}
